# JARVIS Frontend — Environment Variables
# Copy this file to .env.local for local development
# Set these as Environment Variables in your Vercel project dashboard for production

# URL of the AI Engine deployed on Render
# Local dev default (used automatically if this var is not set):  http://localhost:8001
VITE_AI_ENGINE_URL=https://jarvis-ai-engine.onrender.com

# URL of the Core Agent deployed on Render
# Local dev default (used automatically if this var is not set):  http://localhost:8000
VITE_CORE_AGENT_URL=https://jarvis-core-agent.onrender.com
